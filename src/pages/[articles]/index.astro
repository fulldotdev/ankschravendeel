---
import Articles1 from "@/blocks/articles-1"
import { slugs } from "@/data/config.json"
import { getCollection } from "astro:content"

import Layout from "@/components/layout.astro"

export async function getStaticPaths() {
  return [
    {
      params: {
        articles: slugs.articles,
      },
    },
  ]
}

const articles = (await getCollection("articles"))
  .filter((article) => !article.data.draft)
  .sort(
    (a, b) =>
      new Date(b.data.published ?? 0).getTime() -
      new Date(a.data.published ?? 0).getTime()
  )
  .map((article) => {
    return {
      ...article.data,
      href: `/${slugs.articles}/${article.id}/`,
    }
  })
---

<Layout
  title="Blog | Ank Schravendeel"
  description="Artikelen en nieuwsbrieven over meditatie, coaching, zingen en opmerkzaamheid."
>
  <Articles1 articles={articles}>
    <h1>Blog</h1>
    <p>
      Artikelen en nieuwsbrieven over meditatie, coaching, zingen en
      opmerkzaamheid.
    </p>
  </Articles1>
</Layout>
