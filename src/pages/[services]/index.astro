---
import Services1 from "@/blocks/services-1"
import { slugs } from "@/data/config.json"
import { getCollection } from "astro:content"

import Layout from "@/components/layout.astro"

export async function getStaticPaths() {
  return [
    {
      params: {
        services: slugs.services,
      },
    },
  ]
}

const services = (await getCollection("services"))
  .filter((service) => !service.data.draft)
  .map((service) => {
    return {
      ...service.data,
      href: `/${slugs.services}/${service.id}/`,
    }
  })
---

<Layout
  title="Aanbod | Ank Schravendeel"
  description="Een overzicht van coaching, meditatie, retraites en zingen en mediteren bij Ank Schravendeel."
>
  <Services1 services={services}>
    <h1>Een overzicht van mijn aanbod</h1>
    <p>
      Verschillende vormen van begeleiding op het gebied van meditatie en
      coaching.
    </p>
  </Services1>
</Layout>
