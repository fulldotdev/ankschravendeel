---
import Events1 from "@/blocks/events-1"
import { slugs } from "@/data/config.json"
import { getCollection } from "astro:content"

import Layout from "@/components/layout.astro"

export async function getStaticPaths() {
  return [
    {
      params: {
        events: slugs.events,
      },
    },
  ]
}

const events = (await getCollection("events"))
  .filter((event) => !event.data.draft)
  .map((event) => {
    return {
      ...event.data,
      href: `/${slugs.events}/${event.id}/`,
    }
  })
---

<Layout
  title="Agenda | Ank Schravendeel"
  description="Actuele activiteiten, meditatie-ochtenden, retraites en zingen en mediteren."
>
  <Events1 events={events}>
    <h1>Agenda</h1>
    <p>
      Actuele activiteiten, meditatie-ochtenden, retraites en dagen met zingen
      en mediteren.
    </p>
  </Events1>
</Layout>
